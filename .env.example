DMI_ADMIN_USER=dmi-keeper
DMI_ADMIN_PASS=change-me
DMI_SESSION_SECRET=generate-a-long-random-string

# Persistent live content (JSON). Use a disk volume in production.
# DMI_DATA_DIR=/var/dmi/data

# Persistent uploads. Mount the volume on public/uploads so /uploads URLs work.
# DMI_UPLOADS_DIR=/var/dmi/uploads

# Free live host (GitHub + Vercel): editor Save commits these files so the next
# deploy keeps your wiki. Create a classic PAT with "repo" scope (or fine-grained
# Contents: Read and write) and put owner/name of the GitHub repo here.
# GITHUB_REPO=your-github-user/dmi-wiki
# GITHUB_DATA_TOKEN=ghp_xxxxxxxx
# GITHUB_BRANCH=main
